<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="JUKEN 5 — TARGET AFR AUTOTUNE" android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="21 TPS × 61 RPM • Bluetooth SPP • Closed-loop MAP correction" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<EditText android:id="@+id/rpm" android:hint="RPM" android:inputType="number" android:text="3000" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/tps" android:hint="TPS %" android:inputType="numberDecimal" android:text="20" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/afr" android:hint="AFR actual" android:inputType="numberDecimal" android:text="14.70" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/target" android:hint="Target AFR" android:inputType="numberDecimal" android:text="13.80" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<EditText android:id="@+id/gain" android:hint="Gain" android:inputType="numberDecimal" android:text="0.50" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/deadband" android:hint="Deadband %" android:inputType="numberDecimal" android:text="0.15" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/maxcorr" android:hint="Max corr %" android:inputType="numberDecimal" android:text="5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/selection" android:text="Sel: TPS 20% / 3000 rpm" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/autoTuneStart" android:text="START AUTO TUNE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/autoTuneStop" android:text="STOP" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/applyCell" android:text="APPLY CELL" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/reset" android:text="RESET" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<Spinner android:id="@+id/deviceSpinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/connect" android:text="CONNECT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/disconnect" android:text="DISCONNECT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/export" android:text="EXPORT MAP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/status" android:text="Bluetooth belum terhubung. Auto Tune mengubah MAP lokal." android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/live" android:text="LIVE AFR: -" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"><TableLayout android:id="@+id/mapTable" android:layout_width="wrap_content" android:layout_height="wrap_content"/></HorizontalScrollView>
</LinearLayout></ScrollView>