<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="6dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="JUKEN 5 — TARGET AFR AUTOTUNE" android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="JUKEN 5 • FUEL • TIMING • INJECTOR • LIMIT • E-MAP • DIAG • AUTO TUNE • BLUETOOTH" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<EditText android:id="@+id/rpm" android:hint="RPM" android:inputType="number" android:text="3000" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/tps" android:hint="TPS %" android:inputType="numberDecimal" android:text="20" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/afr" android:hint="AFR actual" android:inputType="numberDecimal" android:text="14.70" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/target" android:hint="Target AFR" android:inputType="numberDecimal" android:text="13.80" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<EditText android:id="@+id/gain" android:hint="Gain" android:inputType="numberDecimal" android:text="0.50" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/deadband" android:hint="Deadband" android:inputType="numberDecimal" android:text="0.15" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<EditText android:id="@+id/maxcorr" android:hint="Max corr %" android:inputType="numberDecimal" android:text="5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/selection" android:text="CELL: TPS 20% / RPM 3000" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/stats" android:text="MAP 21×61" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/features" android:text="JUKEN 5 FITUR" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id.ignition" android:text="IGNITION" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/injectorTiming" android:text="INJ TIMING" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/limiter" android:text="LIMITER" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/dwell" android:text="DWELL" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/emap" android:text="E-MAP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/diag" android:text="DIAG" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/ecuTools" android:text="ECU TOOLS" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/project" android:text="PROJECT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/autoTuneStart" android:text="START AUTO TUNE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/autoTuneStop" android:text="STOP" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/applyCell" android:text="APPLY CELL" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/reset" android:text="RESET" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/connect" android:text="CONNECT BT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/disconnect" android:text="DISCONNECT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/packet" android:text="2602 PREVIEW" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/sendTest" android:text="2602 TEST" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/packetLog" android:text="PACKET LOG" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/undo" android:text="UNDO" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/history" android:text="AUTO LOG" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/exportHistory" android:text="EXPORT LOG" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/save" android:text="SAVE MAP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/load" android:text="IMPORT CSV" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/importMap" android:text="IMPORT CSV" android:visibility="gone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/export" android:text="EXPORT CSV" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/backup" android:text="BACKUP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/restore" android:text="RESTORE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/status" android:text="Bluetooth belum terhubung." android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/live" android:text="LIVE AFR: -" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
<TableLayout android:id="@+id/mapTable" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</HorizontalScrollView>
<TextView android:text="Catatan: 2602 mengikuti struktur bytecode yang tersedia. WRITE ECU final belum diaktifkan sampai argumen/index dan ACK/read-back Juken 5 terverifikasi." android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>